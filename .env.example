# QuickHire Rural Digital Public Infrastructure Platform
# Environment Configuration Template (DO NOT COMMIT REAL SECRETS)

# -----------------------------------------------------------------------------
# Frontend Client Environment Variables (Vite - Publicly accessible in bundle)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_ENABLE_LIVE_SMS=true

# Designated Administrator Identity Initial Provisioning Placeholders
# Configured in adminAuth.ts and Supabase Database (admin_users table)
VITE_ADMIN_EMAIL=admin@yourdomain.com
VITE_ADMIN_PHONE=+919876543210

# -----------------------------------------------------------------------------
# Server-Side Secrets (Supabase Edge Function / Auth Send SMS Hook)
# DO NOT put these in the frontend .env or Vercel client environment!
# Set these via Supabase CLI: supabase secrets set FAST2SMS_API_KEY=...
# Or via Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# -----------------------------------------------------------------------------
# FAST2SMS_API_KEY=your-fast2sms-api-key-here
# FAST2SMS_ROUTE=otp
# FAST2SMS_SENDER_ID=optional-dlt-sender-id
# FAST2SMS_TEMPLATE_ID=optional-dlt-template-id
# SEND_SMS_HOOK_SECRET=optional-webhook-secret-token
